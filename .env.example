# Токен бота от @BotFather — единственная обязательная настройка.
BOT_TOKEN=123456789:AAAA...

# Ваш Telegram ID (узнать: @userinfobot) — откроет вам /admin и админ-панель в «Медиатеке».
# Несколько админов — через запятую. Больше никто туда не попадёт.
# ADMIN_IDS=123456789

# Яндекс Музыку каждый пользователь подключает сам: /start в боте → «Подключить Яндекс Музыку».
# (Прежние YANDEX_MUSIC_TOKEN и ALLOWED_USERS больше не нужны: при первом запуске бот сам
#  привяжет старый токен к пользователям из ALLOWED_USERS, после этого строки можно удалить.)

# ---------- Мини-приложение (графический интерфейс внутри Telegram) ----------
# Публичный HTTPS-адрес приложения — см. README, раздел «Мини-приложение».
# WEBAPP_URL=https://music.example.com
# Домен для встроенного Caddy, который сам получит HTTPS-сертификат
# DOMAIN=music.example.com
# Запускать Caddy вместе с ботом (нужен, если указан DOMAIN)
# COMPOSE_PROFILES=https
#
# Или, если у сервера нет открытых портов (NAT), — туннель fxTunnel вместо DuckDNS и Caddy.
# Токен: https://fxtun.ru → личный кабинет → «Токены». WEBAPP_URL тогда можно не писать:
# он будет https://<FXTUNNEL_DOMAIN>.fxtun.ru
# FXTUNNEL_TOKEN=sk_fxtunnel_...
# FXTUNNEL_DOMAIN=my-music
# COMPOSE_PROFILES=tunnel
# Порт веб-сервера и лимит размера загружаемого файла
# WEB_PORT=8080
# WEB_MAX_UPLOAD_MB=300

# ---------- Необязательно ----------
# Максимальный битрейт при скачивании: 64, 128, 192 или 320
# MAX_BITRATE=320
# Где хранить базу: входы пользователей в Яндекс, их настройки, кэш треков
# DATA_DIR=data
# Если сервер не может достучаться до Telegram (в логах «Не удалось связаться с Telegram»):
# прокси для запросов к Telegram — http://user:pass@host:port или socks5://user:pass@host:port
# TELEGRAM_PROXY=socks5://user:pass@1.2.3.4:1080
# Если с самого сервера Telegram открывается, а из Docker — нет, уменьшите MTU сети Docker:
# DOCKER_MTU=1400
# Свой Telegram Bot API сервер (снимает лимиты 20 МБ на приём и 50 МБ на отправку файлов)
# BOT_API_URL=http://localhost:8081
# BOT_API_LOCAL=true
