# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA...

# OAuth-токен Яндекс Музыки (как получить — в README)
YANDEX_MUSIC_TOKEN=y0_AgAAAA...

# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Не знаете свой ID — запустите бота и напишите ему: он ответит вашим ID.
ALLOWED_USERS=

# Необязательно:
# Максимальный битрейт при скачивании: 64, 128, 192 или 320
# MAX_BITRATE=320
# Где хранить кэш и настройки
# DATA_DIR=data
# Свой Telegram Bot API сервер (снимает лимиты 20 МБ на приём и 50 МБ на отправку файлов)
# BOT_API_URL=http://localhost:8081
# BOT_API_LOCAL=true
